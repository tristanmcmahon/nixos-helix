{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gwen task schema (v1)",
  "type": "object",
  "required": ["id", "timestamp", "payload"],
  "properties": {
    "id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "properties": {
        "task": {"type": "string"},
        "text": {"type": "string"},
        "task_body": {"type": "string"}
      },
      "anyOf": [
        {"required": ["text"]},
        {"required": ["task_body"]}
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": {"type": "string"},
        "gmail_message_id": {"type": "string"},
        "log": {"type": "boolean"},
        "model": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
