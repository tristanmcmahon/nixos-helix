# ============================================================================
# Ghostty
# Clean, restrained terminal configuration for the Helix workstation
# ============================================================================

background = #0B0D0C
foreground = #E4E8E5
cursor-color = #81C995
cursor-text = #0B0D0C
selection-background = #315E3E
selection-foreground = #E4E8E5

palette = 0=#0B0D0C
palette = 1=#D77A78
palette = 2=#67B87A
palette = 3=#D6AD63
palette = 4=#76A8B5
palette = 5=#A890B8
palette = 6=#72B6A1
palette = 7=#D6DCD8
palette = 8=#7E8981
palette = 9=#E29491
palette = 10=#81C995
palette = 11=#E2BF7E
palette = 12=#91BCC6
palette = 13=#BDA6C9
palette = 14=#8CCABA
palette = 15=#F1F4F2

# Default workstation terminal font.
font-family = JetBrainsMono Nerd Font Mono
# Compact modern alternative:
# font-family = Maple Mono NF
# Dense high-information alternative:
# font-family = Iosevka Nerd Font Mono
font-size = 13.5

cursor-style = block
cursor-style-blink = false

window-padding-x = 8
window-padding-y = 8

resize-overlay = never
confirm-close-surface = false

scrollback-limit = 100000

mouse-hide-while-typing = true
copy-on-select = clipboard

clipboard-read = allow
clipboard-write = allow

shell-integration = detect

# Ghostty 1.3 replaced audible-bell with feature flags; disable every bell UI.
bell-features = no-system,no-audio,no-attention,no-title,no-border
quit-after-last-window-closed = true
