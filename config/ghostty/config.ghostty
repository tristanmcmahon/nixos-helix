# ============================================================================
# Ghostty
# Clean, restrained terminal configuration for the Helix workstation
# ============================================================================

# Appearance is selected independently so it can be switched live without
# touching the repository-owned baseline configuration.
config-file = /home/tristan/.config/ghostty/profile.ghostty

# Start the first terminal immediately. Every later Ghostty surface runs the
# compositor-neutral chooser before handing the PTY to Bash.
initial-command = direct:/run/current-system/sw/bin/bash
command = direct:/run/current-system/sw/bin/ghostty-surface-shell

cursor-style = block
cursor-style-blink = false

window-padding-x = 8
window-padding-y = 8

resize-overlay = never
confirm-close-surface = false

scrollback-limit = 100000

mouse-hide-while-typing = true
copy-on-select = clipboard

clipboard-read = allow
clipboard-write = allow

shell-integration = bash
# Keep Ghostty's native TERM locally, but use xterm-256color for interactive
# SSH sessions so hosts without xterm-ghostty terminfo retain correct key handling.
shell-integration-features = ssh-env

# Ghostty 1.3 replaced audible-bell with feature flags; disable every bell UI.
bell-features = no-system,no-audio,no-attention,no-title,no-border
quit-after-last-window-closed = true
