{
  "theme": "One Dark",
  "experimental.theme_overrides": {
    "background": "#0B0D0C",
    "border": "@border@",
    "border.variant": "@surfaceHover@",
    "border.focused": "@accent@",
    "border.selected": "@accent@",
    "surface.background": "@surface@",
    "elevated_surface.background": "@surfaceRaised@",
    "element.background": "@surface@",
    "element.hover": "@surfaceHover@",
    "element.active": "@surfaceRaised@",
    "element.selected": "@surfaceRaised@",
    "text": "#E4E8E5",
    "text.muted": "#AEB8B1",
    "text.placeholder": "#7E8981",
    "text.accent": "@accent@",
    "icon.accent": "@accent@",
    "panel.background": "@surface@",
    "status_bar.background": "@surface@",
    "title_bar.background": "@surface@",
    "title_bar.inactive_background": "#0B0D0C",
    "toolbar.background": "#0B0D0C",
    "tab_bar.background": "@surface@",
    "tab.inactive_background": "@surface@",
    "tab.active_background": "@surfaceRaised@",
    "scrollbar.thumb.background": "@surfaceHover@",
    "editor.background": "#0B0D0C",
    "editor.foreground": "#E4E8E5",
    "editor.gutter.background": "#0B0D0C",
    "editor.active_line.background": "@surface@",
    "editor.line_number": "#7E8981",
    "editor.active_line_number": "#E4E8E5",
    "editor.document_highlight.read_background": "@selection@",
    "terminal.background": "#0B0D0C",
    "terminal.foreground": "#E4E8E5",
    "terminal.ansi.green": "@accent@",
    "terminal.ansi.bright_green": "@accentBright@",
    "terminal.ansi.red": "#D77A78",
    "terminal.ansi.yellow": "#D6AD63",
    "error": "#D77A78",
    "warning": "#D6AD63",
    "success": "@accent@"
  }
}
